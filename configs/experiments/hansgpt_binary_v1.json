{
  "experiment": "hansgpt_binary_v1",
  "data_requirements": {
    "full_source_provider": "ModelScope",
    "full_source_shards": 6
  },
  "model": {
    "hidden_size": 768,
    "num_hidden_layers": 12,
    "num_attention_heads": 12,
    "num_key_value_heads": 4,
    "intermediate_size": 2048,
    "max_position_embeddings": 2048
  },
  "training": {
    "seed": 20260907,
    "sequence_length": 1024,
    "batch_size": 2,
    "gradient_accumulation_steps": 32,
    "learning_rate": 0.0003,
    "minimum_learning_rate_ratio": 0.1,
    "weight_decay": 0.1,
    "warmup_tokens": 10000000,
    "target_tokens": 1500000000,
    "max_epochs": 1000,
    "max_grad_norm": 1.0,
    "precision": "fp16",
    "gradient_checkpointing": true,
    "num_workers": 2,
    "sampler": "random",
    "sortish_pool_batches": 64,
    "log_every_steps": 10,
    "validate_every_tokens": 10000000,
    "checkpoint_every_steps": 200,
    "early_stopping_patience": 0,
    "early_stopping_min_tokens": 100000000,
    "early_stopping_min_delta": 0.00001,
    "max_consecutive_overflows": 20
  },
  "evaluation": {
    "batch_size": 2,
    "threshold_candidates": [0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75],
    "retrieval_query_chunk": 256,
    "retrieval_gallery_chunk": 2048,
    "generation_examples": 3,
    "generation_prompt_tokens": 16,
    "generation_lengths": [32, 128, 512]
  }
}
